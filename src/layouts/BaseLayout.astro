---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
} = Astro.props;

const siteName = 'طيف الأمل - دليل أولياء الأمور لتوحد الأطفال';
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- Google AdSense Verification & Auto Ads (Non-Blocking) -->
    <script
      async
      defer
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3694602368387194"
      crossorigin="anonymous"
      fetchpriority="low"
    ></script>

    <!-- SEO Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://easyspot.online/#website",
          "url": "https://easyspot.online/",
          "name": "طيف الأمل",
          "description": "منصة التوعية والدعم لمتلازمة طيف التوحد للأسر العربية",
          "inLanguage": "ar"
        },
        {
          "@type": "Organization",
          "@id": "https://easyspot.online/#organization",
          "name": "طيف الأمل",
          "url": "https://easyspot.online/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://easyspot.online/favicon.svg"
          }
        }
      ]
    })} />

    <meta name="theme-color" content="#1a6b5a" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Highly Optimized Google Fonts (Subset 3 weights instead of 8) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@700&family=Noto+Naskh+Arabic:wght@400;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@700&family=Noto+Naskh+Arabic:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@700&family=Noto+Naskh+Arabic:wght@400;700&display=swap"
      />
    </noscript>

    <!-- Global Styles -->
    <style is:global>
      :root {
        /* Color System - WCAG AA/AAA Compliant */
        --color-primary: #1a6b5a;       /* Deep teal */
        --color-primary-light: #2d8f78;
        --color-primary-xlight: #e8f5f1;
        --color-accent: #b45309;        /* Warm accessible amber */
        --color-accent-light: #fef3c7;
        --color-text: #0f172a;          /* Slate Dark */
        --color-text-muted: #334155;    /* WCAG AA compliant muted text */
        --color-bg: #f8fafc;
        --color-surface: #ffffff;
        --color-border: #cbd5e1;

        /* Typography */
        --font-display: 'Noto Kufi Arabic', system-ui, -apple-system, sans-serif;
        --font-body: 'Noto Naskh Arabic', Georgia, serif;

        /* Spacing rhythm (refined for balanced proportions) */
        --space-xs: 0.35rem;
        --space-sm: 0.75rem;
        --space-md: 1.25rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
        --space-2xl: 4.25rem;

        /* Border radius */
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;

        /* Shadows */
        --shadow-sm: 0 2px 8px rgba(26, 107, 90, 0.08);
        --shadow-md: 0 8px 24px rgba(26, 107, 90, 0.1);
        --shadow-lg: 0 16px 40px rgba(26, 107, 90, 0.12);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.75;
        color: var(--color-text);
        background: var(--color-bg);
        direction: rtl;
        text-align: right;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        max-width: 100vw;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        font-weight: 700;
        line-height: 1.4;
        color: var(--color-text);
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--color-primary-light);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      p {
        margin-bottom: var(--space-sm);
      }

      ul, ol {
        padding-right: var(--space-md);
      }

      /* Utility classes */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .container--narrow {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .section-title {
        font-size: clamp(1.35rem, 3.2vw, 1.85rem);
        font-weight: 800;
        margin-bottom: var(--space-sm);
        color: var(--color-primary);
      }

      .badge {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        font-family: var(--font-display);
        font-size: 0.8rem;
        font-weight: 800;
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        margin-bottom: var(--space-xs);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .btn {
        display: inline-block;
        padding: 0.75rem 1.75rem;
        border-radius: var(--radius-sm);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.22s ease;
        border: none;
        text-decoration: none;
      }

      .btn--primary {
        background: var(--color-primary);
        color: #fff;
        box-shadow: 0 4px 16px rgba(26, 107, 90, 0.28);
      }

      .btn--primary:hover {
        background: var(--color-primary-light);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(26, 107, 90, 0.35);
      }

      .btn--outline {
        background: transparent;
        border: 2px solid var(--color-primary);
        color: var(--color-primary);
      }

      .btn--outline:hover {
        background: var(--color-primary);
        color: #fff;
      }

      /* Article content styles */
      .article-body h2 {
        font-size: 1.35rem;
        color: var(--color-primary);
        margin-top: var(--space-lg);
        margin-bottom: var(--space-sm);
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--color-border);
      }

      .article-body h3 {
        font-size: 1.15rem;
        margin-top: var(--space-md);
        margin-bottom: var(--space-xs);
      }

      .article-body ul, .article-body ol {
        margin-bottom: var(--space-sm);
      }

      .article-body li {
        margin-bottom: 0.4rem;
      }

      .table-wrapper {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 1.5rem 0;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        box-sizing: border-box;
      }

      .table-wrapper::-webkit-scrollbar {
        height: 7px;
      }

      .table-wrapper::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 4px;
      }

      .article-body table,
      table {
        width: 100%;
        min-width: 580px;
        border-collapse: collapse;
        margin: 0;
        font-size: 0.92rem;
        background: var(--color-surface);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        display: table;
        box-sizing: border-box;
      }

      .article-body th {
        background: var(--color-primary);
        color: #fff;
        padding: 0.85rem 1rem;
        font-family: var(--font-display);
        font-weight: 700;
        text-align: right;
        white-space: nowrap;
      }

      .article-body td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-border);
        text-align: right;
        line-height: 1.6;
      }

      .article-body tr:last-child td {
        border-bottom: none;
      }

      .article-body tr:nth-child(even) td {
        background: var(--color-primary-xlight);
      }

      /* Mobile Table Controls & Cards Styling */
      .table-mobile-bar {
        display: none;
        margin: 1.25rem 0 0.5rem;
      }

      .table-view-switcher {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-primary-xlight);
        padding: 0.45rem 0.75rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
      }

      .switcher-text {
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--color-primary);
      }

      .tbl-mode-btn {
        background: #ffffff;
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 700;
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .tbl-mode-btn--active {
        background: var(--color-primary) !important;
        color: #ffffff !important;
        border-color: var(--color-primary) !important;
        box-shadow: 0 2px 6px rgba(26, 107, 90, 0.25);
      }

      .table-scroll-hint {
        font-size: 0.8rem;
        color: var(--color-text-muted);
        text-align: center;
        background: #f1f5f9;
        padding: 0.4rem;
        border-radius: var(--radius-sm);
        margin-bottom: 0.5rem;
        font-family: var(--font-display);
        font-weight: 600;
      }

      @media (max-width: 768px) {
        .table-mobile-bar {
          display: block;
        }

        /* Responsive Cards View (Mobile Default) */
        .table-wrapper.is-cards-view {
          overflow-x: visible !important;
          background: transparent !important;
          border: none !important;
          box-shadow: none !important;
          margin: 0.5rem 0 1.5rem !important;
        }

        .table-wrapper.is-cards-view table,
        .table-wrapper.is-cards-view tbody,
        .table-wrapper.is-cards-view tr,
        .table-wrapper.is-cards-view td {
          display: block !important;
          width: 100% !important;
          min-width: 0 !important;
          box-sizing: border-box !important;
        }

        .table-wrapper.is-cards-view thead {
          display: none !important;
        }

        .table-wrapper.is-cards-view tr {
          background: #ffffff !important;
          border: 1.5px solid var(--color-border) !important;
          border-radius: var(--radius-md) !important;
          padding: 1.15rem !important;
          margin-bottom: 1.15rem !important;
          box-shadow: 0 3px 12px rgba(15, 23, 42, 0.06) !important;
          border-right: 5px solid var(--color-primary) !important;
        }

        .table-wrapper.is-cards-view tr:nth-child(even) td {
          background: transparent !important;
        }

        .table-wrapper.is-cards-view td {
          padding: 0.65rem 0 !important;
          border: none !important;
          border-bottom: 1px dashed #e2e8f0 !important;
          font-size: 0.98rem !important;
          line-height: 1.7 !important;
          text-align: right !important;
          background: transparent !important;
        }

        .table-wrapper.is-cards-view td:last-child {
          border-bottom: none !important;
          padding-bottom: 0 !important;
        }

        /* First cell behaves as the primary card title */
        .table-wrapper.is-cards-view td:first-child {
          font-size: 1.18rem !important;
          font-weight: 900 !important;
          color: var(--color-primary) !important;
          padding-top: 0 !important;
          border-bottom: 2px solid var(--color-primary-xlight) !important;
          margin-bottom: 0.45rem !important;
          padding-bottom: 0.55rem !important;
          display: flex !important;
          align-items: center !important;
          gap: 0.4rem !important;
        }

        /* Subsequent cells show their column title as a label */
        .table-wrapper.is-cards-view td:not(:first-child)::before {
          content: attr(data-label) ": ";
          display: block;
          font-family: var(--font-display);
          font-weight: 800;
          font-size: 0.85rem;
          color: var(--color-accent);
          margin-bottom: 0.25rem;
        }

        /* Traditional Table View (When user clicks switch on mobile) */
        .table-wrapper.is-table-view {
          overflow-x: auto !important;
          -webkit-overflow-scrolling: touch !important;
          border: 1px solid var(--color-border) !important;
          background: var(--color-surface) !important;
        }

        .table-wrapper.is-table-view table {
          min-width: 580px !important;
        }
      }

      .info-box {
        background: var(--color-primary-xlight);
        border-right: 4px solid var(--color-primary);
        border-radius: var(--radius-sm);
        padding: var(--space-md);
        margin: var(--space-md) 0;
      }

      .info-box--accent {
        background: var(--color-accent-light);
        border-right: 4px solid var(--color-accent);
      }

      .article-body,
      article.article-body {
        width: 100% !important;
        box-sizing: border-box !important;
        padding-left: 1.25rem !important;
        padding-right: 1.25rem !important;
        word-break: break-word !important;
        overflow-wrap: break-word !important;
      }

      /* Responsive */
      @media (max-width: 768px) {
        :root {
          --space-sm: 0.65rem;
          --space-md: 1rem;
          --space-lg: 1.5rem;
          --space-xl: 2.25rem;
          --space-2xl: 3rem;
        }

        body {
          font-size: 0.95rem;
          line-height: 1.7;
        }

        .container {
          padding: 0 var(--space-sm);
        }

        .btn {
          padding: 0.7rem 1.4rem;
          font-size: 0.9rem;
        }

        .article-body,
        article.article-body {
          padding-left: 1rem !important;
          padding-right: 1rem !important;
        }

        .article-hero {
          padding: 1.5rem 1rem 1.25rem !important;
        }

        .article-meta {
          flex-direction: column !important;
          gap: 0.4rem !important;
        }

        .article-meta span {
          width: 100% !important;
          display: inline-flex !important;
        }

        .article-body h2 {
          font-size: 1.25rem;
        }

        .article-body h3 {
          font-size: 1.05rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <header class="site-header">
      <div class="container">
        <nav class="nav">
          <a href="/" class="nav__logo">
            <span class="nav__logo-icon">🌟</span>
            <span class="nav__logo-text">طيف الأمل</span>
          </a>
          <button class="nav__toggle" aria-label="القائمة" aria-expanded="false" type="button" id="navToggle">
            <span></span><span></span><span></span>
          </button>
          <ul class="nav__links" id="navLinks">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/articles/">المقالات</a></li>
            <li><a href="/tools/">أدوات تعليمية</a></li>
            <li><a href="/games/">ألعاب أطفال 🎮</a></li>
            <li><a href="/about/">من نحن</a></li>
            <li><a href="/contact/">تواصل معنا</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="footer-logo">🌟 طيف الأمل</div>
            <p>دليلك الموثوق لدعم طفلك في رحلة طيف التوحد — بمحتوى علمي مبسط باللغة العربية.</p>
          </div>
          <div class="footer-links">
            <h4>الأقسام</h4>
            <ul>
              <li><a href="/articles/">جميع المقالات</a></li>
              <li><a href="/tools/">الأدوات التعليمية</a></li>
              <li><a href="/games/">ألعاب تعليمية تفاعلية</a></li>
              <li><a href="/about/">من نحن</a></li>
              <li><a href="/contact/">تواصل معنا</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>مواضيع مهمة</h4>
            <ul>
              <li><a href="/articles/autism-levels-diagnosis/">مستويات التوحد والتشخيص</a></li>
              <li><a href="/articles/aba-therapy-home/">العلاج السلوكي في المنزل</a></li>
              <li><a href="/articles/visual-schedules-flashcards/">الجداول البصرية والبطاقات</a></li>
              <li><a href="/articles/social-stories/">القصص الاجتماعية</a></li>
              <li><a href="/articles/apps-books/">تطبيقات وكتب مُوصى بها</a></li>
              <li><a href="/articles/autism-faq/">أسئلة شائعة عن التوحد</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>قانوني</h4>
            <ul>
              <li><a href="/privacy-policy/">سياسة الخصوصية</a></li>
              <li><a href="/terms/">الشروط والأحكام</a></li>
              <li><a href="/disclaimer/">إخلاء المسؤولية</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} طيف الأمل. جميع الحقوق محفوظة.</p>
          <p class="footer-disclaimer">المحتوى على هذا الموقع لأغراض تعليمية فقط وليس بديلاً عن الاستشارة الطبية المتخصصة.</p>
        </div>
      </div>
    </footer>

    <style>
      /* Header & Nav */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 70px;
        gap: var(--space-md);
      }

      .nav__logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.35rem;
        color: var(--color-primary);
        text-decoration: none;
        white-space: nowrap;
      }

      .nav__logo-icon {
        font-size: 1.5rem;
      }

      .nav__links {
        display: flex;
        list-style: none;
        gap: var(--space-md);
        padding: 0;
        margin: 0;
      }

      .nav__links a {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
      }

      .nav__links a:hover {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
      }

      .nav__toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
      }

      .nav__toggle span {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--color-primary);
        border-radius: 2px;
        transition: all 0.2s;
      }

      /* Footer */
      .site-footer {
        background: var(--color-text);
        color: rgba(255,255,255,0.75);
        padding: var(--space-xl) 0 var(--space-md);
        margin-top: var(--space-2xl);
        content-visibility: auto;
        contain-intrinsic-size: 1px 400px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: var(--space-lg);
        margin-bottom: var(--space-lg);
      }

      .footer-logo {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.25rem;
        color: #fff;
        margin-bottom: var(--space-sm);
      }

      .footer-brand p {
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .footer-links h4 {
        font-family: var(--font-display);
        font-weight: 700;
        color: #fff;
        margin-bottom: var(--space-sm);
        font-size: 1rem;
      }

      .footer-links ul {
        list-style: none;
        padding: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: rgba(255,255,255,0.65);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--color-accent);
      }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: var(--space-md);
        text-align: center;
        font-size: 0.85rem;
      }

      .footer-disclaimer {
        color: rgba(255,255,255,0.45);
        margin-top: 0.25rem;
        font-size: 0.8rem;
      }

      /* Responsive */
      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--space-md);
        }
      }

      @media (max-width: 820px) {
        .nav__links {
          display: none;
          position: absolute;
          top: 70px;
          right: 0;
          left: 0;
          background: #ffffff;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem 1.25rem 1rem;
          border-bottom: 2px solid var(--color-border);
          box-shadow: 0 12px 28px rgba(0,0,0,0.1);
          z-index: 999;
        }

        .nav__links.is-open {
          display: flex;
        }

        .nav__links li {
          border-bottom: 1px solid var(--color-primary-xlight);
        }

        .nav__links li:last-child {
          border-bottom: none;
        }

        .nav__links a {
          font-size: 1rem;
          padding: 0.85rem 0.5rem;
          display: block;
        }

        .nav__toggle {
          display: flex;
        }

        .site-footer {
          text-align: center;
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: var(--space-lg);
          text-align: center;
        }

        .footer-brand {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-brand p {
          max-width: 440px;
          margin: 0 auto;
          text-align: center;
        }

        .footer-logo {
          text-align: center;
        }

        .footer-links {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-links h4 {
          text-align: center;
        }

        .footer-links ul {
          padding: 0;
          margin: 0;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .footer-links li {
          text-align: center;
        }

        .footer-links a {
          display: inline-block;
          text-align: center;
        }

        .footer-bottom {
          text-align: center;
        }
      }
    </style>

    <script is:inline>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      // Mobile Responsive Tables Enhancer
      function initMobileTables() {
        const tables = document.querySelectorAll('.table-wrapper table, .article-body table, table');
        tables.forEach((table) => {
          if (table.hasAttribute('data-mobile-enhanced')) return;
          table.setAttribute('data-mobile-enhanced', 'true');

          const wrapper = table.closest('.table-wrapper') || table.parentElement;
          if (!wrapper) return;

          // Extract column headers
          const ths = Array.from(table.querySelectorAll('thead th')).map((th) => th.textContent.trim());
          if (ths.length === 0) return;

          // Assign data-label to each td
          const rows = table.querySelectorAll('tbody tr');
          rows.forEach((tr) => {
            const tds = tr.querySelectorAll('td');
            tds.forEach((td, idx) => {
              if (ths[idx]) {
                td.setAttribute('data-label', ths[idx]);
              }
            });
          });

          // Create mobile switcher controls
          const bar = document.createElement('div');
          bar.className = 'table-mobile-bar';
          bar.innerHTML = `
            <div class="table-view-switcher">
              <span class="switcher-text">📱 طريقة العرض:</span>
              <button type="button" class="tbl-mode-btn tbl-mode-btn--active" data-mode="cards">بطاقات مريحة</button>
              <button type="button" class="tbl-mode-btn" data-mode="table">جدول تقليدي</button>
            </div>
            <div class="table-scroll-hint" style="display:none;">👈 يمكنك سحب الجدول أفقياً لرؤية كافة الأعمدة 👉</div>
          `;

          wrapper.parentNode.insertBefore(bar, wrapper);
          wrapper.classList.add('is-cards-view');

          const btnCards = bar.querySelector('[data-mode="cards"]');
          const btnTable = bar.querySelector('[data-mode="table"]');
          const hint = bar.querySelector('.table-scroll-hint');

          btnCards?.addEventListener('click', () => {
            btnCards.classList.add('tbl-mode-btn--active');
            btnTable?.classList.remove('tbl-mode-btn--active');
            wrapper.classList.add('is-cards-view');
            wrapper.classList.remove('is-table-view');
            if (hint) hint.style.display = 'none';
          });

          btnTable?.addEventListener('click', () => {
            btnTable.classList.add('tbl-mode-btn--active');
            btnCards?.classList.remove('tbl-mode-btn--active');
            wrapper.classList.remove('is-cards-view');
            wrapper.classList.add('is-table-view');
            if (hint) hint.style.display = 'block';
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileTables);
      } else {
        initMobileTables();
      }
    </script>
  </body>
</html>
