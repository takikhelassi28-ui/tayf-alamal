---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pool of in-depth guides and articles to feature dynamically
const allArticles = [
  {
    category: 'Auto Insurance',
    badge: 'Benchmark',
    title: 'Car Insurance Rates in 2026: Complete National Benchmark & Carrier Cost Analysis',
    excerpt: 'Full breakdown of national averages ($2,388/yr full coverage vs $784/yr minimum), carrier rate spreads, and top discount levers.',
    url: '/guides/auto-insurance/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '11 min read',
    date: 'Oct 2026',
    tagIcon: '🚗'
  },
  {
    category: 'Medicare & Health',
    badge: 'Comparison',
    title: 'Medicare Advantage vs. Medigap (Plan G & Plan N) in 2026: Definitive Guide',
    excerpt: 'The true trade-offs between $0 premium Advantage HMO/PPO plans and unrestricted doctor freedom with Medigap Plan G.',
    url: '/guides/health-insurance/',
    reviewer: 'David Sterling, CLU',
    readTime: '12 min read',
    date: 'Oct 2026',
    tagIcon: '🏥'
  },
  {
    category: 'Homeowners',
    badge: 'Property Guide',
    title: 'Homeowners Insurance Cost Breakdown: Replacement Cost vs. Market Value',
    excerpt: 'Why insuring your home based on market price is a costly mistake, and three essential endorsements every homeowner needs.',
    url: '/guides/home-insurance/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '10 min read',
    date: 'Sep 2026',
    tagIcon: '🏡'
  },
  {
    category: 'Life Insurance',
    badge: 'Actuarial Audit',
    title: 'Term vs. Whole Life Insurance: Comprehensive Cost Comparison & Rate Benchmark',
    excerpt: 'Actuarial monthly premium tables across ages 25 to 65, cash value fee realities, and the "Buy Term and Invest the Difference" math.',
    url: '/guides/life-insurance/',
    reviewer: 'Elena Rostova, CFP®',
    readTime: '14 min read',
    date: 'Sep 2026',
    tagIcon: '🛡️'
  },
  {
    category: 'State Matrices',
    badge: '50-State Ranking',
    title: 'Car Insurance Rates by State in 2026: 50-State Ranking & Cost Matrix',
    excerpt: 'Interactive table comparing Maine ($1,170/yr) to Florida ($3,640/yr), no-fault tort systems, and uninsured motorist contagion.',
    url: '/guides/state-car-insurance-averages/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '13 min read',
    date: 'Oct 2026',
    tagIcon: '📊'
  },
  {
    category: 'Commercial',
    badge: 'Small Business',
    title: 'Small Business General Liability Insurance: Costs, Limits & BOP Bundles',
    excerpt: 'Understand the standard $1M/$2M occurrence limit, class code costs by industry, and how Business Owner\'s Policies save 20%.',
    url: '/guides/commercial-insurance/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '9 min read',
    date: 'Sep 2026',
    tagIcon: '🏢'
  },
  {
    category: 'Auto Savings',
    badge: 'Cost Cutting',
    title: 'The Budget Driver’s Guide to Affordable Car Insurance: 7 Proven Strategies',
    excerpt: 'How adjusting comprehensive/collision deductibles from $500 to $1,000 saves up to 28% without sacrificing catastrophic liability.',
    url: '/guides/cheap-car-insurance-guide/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '8 min read',
    date: 'Oct 2026',
    tagIcon: '💡'
  },
  {
    category: 'Credit & Underwriting',
    badge: 'Actuarial Deep Dive',
    title: 'Credit-Based Insurance Scores: How FICO Affects Your Premiums by up to 71%',
    excerpt: 'Why 46 states allow insurers to price policies using credit tiers, and what consumers in CA, MA, and HI can expect.',
    url: '/guides/insurance-score-factors/',
    reviewer: 'Elena Rostova, CFP®',
    readTime: '10 min read',
    date: 'Sep 2026',
    tagIcon: '📈'
  },
  {
    category: 'Bundling',
    badge: 'Multi-Policy',
    title: 'Home & Auto Insurance Bundling Guide: Real Discounts vs. Decoupled Policies',
    excerpt: 'When bundling multi-policy discounts deliver genuine 18% savings vs when mono-line specialty carriers beat the package.',
    url: '/guides/home-auto-bundle/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '9 min read',
    date: 'Sep 2026',
    tagIcon: '🔗'
  },
  {
    category: 'Medicare Timing',
    badge: 'Enrollment Alert',
    title: 'Medicare Open Enrollment 2026: Annual Notice of Change (ANOC) Survival Guide',
    excerpt: 'How carrier formulary adjustments and drug tier restructurings impact out-of-pocket costs between October 15 and December 7.',
    url: '/guides/medicare-open-enrollment/',
    reviewer: 'David Sterling, CLU',
    readTime: '11 min read',
    date: 'Oct 2026',
    tagIcon: '⏰'
  },
  {
    category: 'Workers’ Comp',
    badge: 'Regulatory Rules',
    title: 'Workers’ Compensation Insurance Fundamentals: E-Mod Ratings & Payroll Audits',
    excerpt: 'Demystifying experience modification rates (EMR), class code classification, and how to avoid painful annual payroll audit penalties.',
    url: '/guides/commercial-workers-comp/',
    reviewer: 'Marcus Vance, CPCU',
    readTime: '10 min read',
    date: 'Sep 2026',
    tagIcon: '👷'
  }
];

// Curated insurance market news & regulatory alerts
const marketNews = [
  {
    source: 'NAIC Regulatory Update',
    date: 'October 2026',
    title: 'State Regulators Scrutinize Telematics & Driving Score Algorithms',
    summary: 'Several state insurance commissioners opened formal inquiries into mobile app driving trackers to ensure price discrimination protections.',
    tag: 'Regulation',
    readLink: '/guides/insurance-score-factors/'
  },
  {
    source: 'Actuarial Market Brief',
    date: 'October 2026',
    title: 'Average Replacement Cost Values Rise 6.4% Due to Skilled Labor & Material Trends',
    summary: 'Insurers adjust Coverage A minimums nationwide; homeowners are urged to verify their 100% reconstruction cost guarantees.',
    tag: 'Property Trends',
    readLink: '/guides/home-insurance/'
  },
  {
    source: 'Centers for Medicare & Medicaid',
    date: 'October 2026',
    title: 'Medicare Part D Out-of-Pocket Cap Restructures Senior Prescription Plans',
    summary: 'The landmark $2,000 annual drug spend cap prompts insurers to re-balance Advantage HMO copays heading into open enrollment.',
    tag: 'Medicare Alert',
    readLink: '/guides/medicare-open-enrollment/'
  },
  {
    source: 'Highway Loss Data Institute (HLDI)',
    date: 'September 2026',
    title: 'EV Collision Repair Severities Drive Higher Comprehensive Premiums',
    summary: 'Sensor calibration and specialized battery repair protocols push average collision claim costs 24% above ICE vehicle counterparts.',
    tag: 'Auto Intelligence',
    readLink: '/guides/auto-insurance/'
  }
];

// Verified Actuarial & Consumer Insurance Facts
const insuranceFacts = [
  {
    number: '71%',
    label: 'Credit Rating Premium Delta',
    fact: 'In states allowing credit-based insurance scores, drivers with poor credit pay up to 71% more for the exact same coverage than drivers with excellent scores.',
    source: 'Consumer Federation of America & NAIC Data'
  },
  {
    number: '$2,388',
    label: '2026 National Auto Benchmark',
    fact: 'The 2026 nationwide benchmark for full coverage auto insurance ($100k/$300k/$100k limits with $500 deductibles) across all 50 states.',
    source: 'QuoteShield Rate Index & SERFF Filings'
  },
  {
    number: '18%–24%',
    label: 'Average Bundle Savings',
    fact: 'Combining your homeowners and personal auto policies with the same carrier yields an average discount of 18% to 24% across top nationwide insurers.',
    source: 'Insurance Information Institute (Triple-I)'
  },
  {
    number: '80%',
    label: 'The Coinsurance Clause Rule',
    fact: 'Most standard homeowners policies require your dwelling coverage (Coverage A) to equal at least 80% of replacement cost to receive full claim payouts on partial losses.',
    source: 'ISO Standard Homeowners Policy Form HO-3'
  },
  {
    number: '1 in 8',
    label: 'Uninsured Drivers Nationwide',
    fact: 'Approximately 12.6% of motorists drive without active liability insurance, spiking Uninsured/Underinsured Motorist (UM/UIM) claim volumes.',
    source: 'Insurance Research Council (IRC)'
  },
  {
    number: '10x–12x',
    label: 'Income Replacement Standard',
    fact: 'Financial planners recommend life insurance death benefits equivalent to 10 to 12 times gross annual income plus outstanding debt balance (the DIME method).',
    source: 'Certified Financial Planner Board Standards'
  }
];
---

<BaseLayout
  title="QuoteShield — Independent Insurance Intelligence & Rate Benchmarks"
  description="Compare 2026 auto, health, Medicare, homeowners, and life insurance rates with QuoteShield. Independent, non-commission research backed by certified insurance professionals."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge badge-trust">🛡️ 2026 Public Rate Filing Benchmarks</span>
      </div>
      <h1 class="hero-title">
        Transparent Insurance Intelligence.<br />Zero Sales Calls.
      </h1>
      <p class="hero-lead">
        We analyze public rate filings from state insurance commissioners and the NAIC so you can benchmark your real costs, unlock unadvertised discounts, and avoid costly underinsurance.
      </p>

      <!-- Quick Interactive Category Hub -->
      <div class="category-cards-grid">
        <a href="/guides/auto-insurance/" class="category-card">
          <div class="cat-icon">🚗</div>
          <h3>Auto Insurance</h3>
          <p>National benchmarks, state matrices & cheap carrier audits.</p>
          <span class="cat-link">Compare Rates &rarr;</span>
        </a>

        <a href="/guides/health-insurance/" class="category-card">
          <div class="cat-icon">🏥</div>
          <h3>Health & Medicare</h3>
          <p>Medicare Advantage vs Medigap Plan G and open enrollment rules.</p>
          <span class="cat-link">Compare Plans &rarr;</span>
        </a>

        <a href="/guides/home-insurance/" class="category-card">
          <div class="cat-icon">🏡</div>
          <h3>Homeowners</h3>
          <p>Replacement cost vs market value & storm deductibles.</p>
          <span class="cat-link">Calculate Costs &rarr;</span>
        </a>

        <a href="/guides/life-insurance/" class="category-card">
          <div class="cat-icon">🛡️</div>
          <h3>Life Insurance</h3>
          <p>Term vs whole life actuarial costs by age & coverage sizing.</p>
          <span class="cat-link">Explore Terms &rarr;</span>
        </a>

        <a href="/guides/commercial-insurance/" class="category-card">
          <div class="cat-icon">🏢</div>
          <h3>Small Business</h3>
          <p>General liability $1M/$2M limits, BOP bundles & workers' comp.</p>
          <span class="cat-link">Commercial Guide &rarr;</span>
        </a>

        <a href="/tools/" class="category-card highlight-tool-card">
          <div class="cat-icon">🧮</div>
          <h3>Decision Calculators</h3>
          <p>Interactive auto savings & DIME life insurance estimators.</p>
          <span class="cat-link">Launch Tools &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Stats Banner -->
  <section class="trust-banner">
    <div class="container trust-grid">
      <div class="trust-item">
        <span class="trust-num">50+</span>
        <span class="trust-txt">Top Carriers Analyzed</span>
      </div>
      <div class="trust-item">
        <span class="trust-num">120K+</span>
        <span class="trust-txt">State Rate Filings Benchmarked</span>
      </div>
      <div class="trust-item">
        <span class="trust-num">100%</span>
        <span class="trust-txt">Independent & Unbiased</span>
      </div>
      <div class="trust-item">
        <span class="trust-num">0</span>
        <span class="trust-txt">Telemarketing Robocalls</span>
      </div>
    </div>
  </section>

  <!-- Featured Intelligence Guides -->
  <section class="container section-padding">
    <div class="section-header-row">
      <div>
        <span class="badge badge-primary">Deep Dive Research</span>
        <h2>Featured Insurance Intelligence & Rate Guides</h2>
        <p class="section-subtext">Actionable, data-backed guides reviewed by credentialed underwriters and financial planners.</p>
      </div>
    </div>

    <div class="guides-grid">
      <!-- Guide Card 1 -->
      <article class="guide-card card">
        <div class="guide-tag">Auto Insurance</div>
        <h3><a href="/guides/auto-insurance/">Car Insurance Rates in 2026: Complete National Benchmark & Carrier Cost Analysis</a></h3>
        <p>Full breakdown of national averages ($2,388/yr full coverage vs $784/yr minimum), carrier rate spreads, and top discount levers.</p>
        <div class="guide-meta">
          <span>Reviewed by Marcus Vance, CPCU</span>
          <a href="/guides/auto-insurance/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>

      <!-- Guide Card 2 -->
      <article class="guide-card card">
        <div class="guide-tag">Medicare & Health</div>
        <h3><a href="/guides/health-insurance/">Medicare Advantage vs. Medigap (Plan G & Plan N) in 2026: Definitive Guide</a></h3>
        <p>The true trade-offs between $0 premium Advantage HMO/PPO plans and unrestricted doctor freedom with Medigap Plan G.</p>
        <div class="guide-meta">
          <span>Reviewed by David Sterling, CLU</span>
          <a href="/guides/health-insurance/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>

      <!-- Guide Card 3 -->
      <article class="guide-card card">
        <div class="guide-tag">Homeowners</div>
        <h3><a href="/guides/home-insurance/">Homeowners Insurance Cost Breakdown: Replacement Cost vs. Market Value</a></h3>
        <p>Why insuring your home based on market price is a costly mistake, and three essential endorsements every homeowner needs.</p>
        <div class="guide-meta">
          <span>Reviewed by Marcus Vance, CPCU</span>
          <a href="/guides/home-insurance/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>

      <!-- Guide Card 4 -->
      <article class="guide-card card">
        <div class="guide-tag">Life Insurance</div>
        <h3><a href="/guides/life-insurance/">Term vs. Whole Life Insurance: Comprehensive Cost Comparison & Rate Benchmark</a></h3>
        <p>Actuarial monthly premium tables across ages 25 to 65, cash value fee realities, and the "Buy Term and Invest the Difference" math.</p>
        <div class="guide-meta">
          <span>Reviewed by Elena Rostova, CFP®</span>
          <a href="/guides/life-insurance/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>

      <!-- Guide Card 5 -->
      <article class="guide-card card">
        <div class="guide-tag">State Rates</div>
        <h3><a href="/guides/state-car-insurance-averages/">Car Insurance Rates by State in 2026: 50-State Ranking & Cost Matrix</a></h3>
        <p>Interactive table comparing Maine ($1,170/yr) to Florida ($3,640/yr), no-fault tort systems, and uninsured motorist contagion.</p>
        <div class="guide-meta">
          <span>Reviewed by Marcus Vance, CPCU</span>
          <a href="/guides/state-car-insurance-averages/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>

      <!-- Guide Card 6 -->
      <article class="guide-card card">
        <div class="guide-tag">Commercial</div>
        <h3><a href="/guides/commercial-insurance/">Small Business General Liability Insurance: Costs, Limits & BOP Bundles</a></h3>
        <p>Understand the standard $1M/$2M occurrence limit, class code costs by industry, and how Business Owner's Policies save 20%.</p>
        <div class="guide-meta">
          <span>Reviewed by Marcus Vance, CPCU</span>
          <a href="/guides/commercial-insurance/" class="read-more">Read Guide &rarr;</a>
        </div>
      </article>
    </div>
  </section>

  <!-- Interactive Calculators Feature Section -->
  <section class="calculator-promo-section">
    <div class="container promo-grid">
      <div class="promo-text">
        <span class="badge badge-trust">Client-Side Privacy</span>
        <h2>Try Our Free Interactive Insurance Decision Tools</h2>
        <p>
          We built our calculators so you can simulate your options in complete privacy. No contact forms, no phone numbers required, and zero telemarketer harassment.
        </p>
        <div class="promo-actions">
          <a href="/tools/auto-savings-calculator/" class="btn btn-primary">Auto Savings Calculator</a>
          <a href="/tools/life-insurance-calculator/" class="btn btn-secondary">Life Coverage Estimator</a>
        </div>
      </div>
      <div class="promo-features card">
        <div class="feature-row">
          <div class="feat-icon">🎯</div>
          <div>
            <h4>State-Specific Actuarial Modeling</h4>
            <p>Calculates rate adjustments based on your state's actual statutory loss ratio.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feat-icon">🔒</div>
          <div>
            <h4>100% In-Browser Computation</h4>
            <p>Your inputs remain on your device and are never sent to a marketing server.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feat-icon">💡</div>
          <div>
            <h4>Actionable Discount Playbooks</h4>
            <p>Learn exactly what levers to request when speaking with a licensed agent.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Rate Insurers Section -->
  <section class="container section-padding">
    <div class="methodology-intro">
      <span class="badge badge-primary">E-E-A-T Standards</span>
      <h2>Our Independent Carrier Rating Framework</h2>
      <p>
        QuoteShield does not sell carrier rankings or allow insurers to sponsor their scores. Every underwriter is measured against our strict 5-pillar standard:
      </p>
    </div>

    <div class="pillars-grid">
      <div class="pillar-box">
        <span class="pillar-num">25%</span>
        <h4>Financial Solvency</h4>
        <p>AM Best, S&P, and Fitch ratings guaranteeing catastrophe claim-paying capacity.</p>
      </div>
      <div class="pillar-box">
        <span class="pillar-num">25%</span>
        <h4>Claim Satisfaction</h4>
        <p>NAIC National Complaint Index and J.D. Power verified consumer satisfaction surveys.</p>
      </div>
      <div class="pillar-box">
        <span class="pillar-num">20%</span>
        <h4>Coverage Breadth</h4>
        <p>Endorsement flexibility (OEM parts, accident forgiveness, water backup, umbrella).</p>
      </div>
      <div class="pillar-box">
        <span class="pillar-num">20%</span>
        <h4>Price Competitiveness</h4>
        <p>Public SERFF rate filings evaluated across multiple risk and demographic brackets.</p>
      </div>
      <div class="pillar-box">
        <span class="pillar-num">10%</span>
        <h4>Digital Experience</h4>
        <p>Mobile claim submission speed, digital policy management, and 24/7 service.</p>
      </div>
    </div>
  </section>

  <!-- Dynamic Section: Random Articles Discovery, Market News & Key Facts -->
  <section class="container section-padding dynamic-intel-section">
    <div class="intel-header">
      <div class="intel-title-group">
        <span class="badge badge-accent">⚡ Intelligence Stream</span>
        <h2>Insurance Wire: Random Articles, Market News & Key Facts</h2>
        <p class="section-subtext">Real-time statutory updates, random deep-dive guides, and verified actuarial facts updated for 2026.</p>
      </div>
      <button id="shuffle-articles-btn" class="btn btn-outline-refresh" aria-label="Shuffle random articles">
        <span class="refresh-icon">🔄</span> Shuffle Random Guides
      </button>
    </div>

    <!-- 3-Column Layout: Random Guides (2 cols) + News & Facts (1 col) -->
    <div class="intel-layout-grid">
      <!-- Left: Random Interactive Article Explorer (Card Slots) -->
      <div class="intel-articles-col">
        <div class="col-subheading">
          <h3>🎲 Random Featured Deep Dives</h3>
          <span class="pulse-indicator">Click shuffle to load other guides</span>
        </div>

        <div id="random-articles-container" class="random-articles-grid">
          {allArticles.slice(0, 4).map((art) => (
            <article class="random-article-card card" data-slug={art.url}>
              <div class="card-top-bar">
                <span class="tag-badge">{art.tagIcon} {art.category}</span>
                <span class="read-time">{art.readTime}</span>
              </div>
              <h4 class="random-card-title">
                <a href={art.url}>{art.title}</a>
              </h4>
              <p class="random-card-excerpt">{art.excerpt}</p>
              <div class="card-footer">
                <span class="reviewer-stamp">✓ {art.reviewer}</span>
                <a href={art.url} class="intel-read-btn">Read Article &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Right: Market News & Actuarial Fast Facts -->
      <div class="intel-sidebar-col">
        <!-- Live News Wire Card -->
        <div class="sidebar-block card news-block">
          <div class="block-header">
            <span class="block-icon">📰</span>
            <div>
              <h3>Insurance Market News</h3>
              <span class="block-meta">Public Filings & CMS Notices</span>
            </div>
          </div>
          <div class="news-list">
            {marketNews.map((news) => (
              <div class="news-item">
                <div class="news-meta">
                  <span class="news-tag">{news.tag}</span>
                  <span class="news-date">{news.date}</span>
                </div>
                <h4 class="news-title">
                  <a href={news.readLink}>{news.title}</a>
                </h4>
                <p class="news-summary">{news.summary}</p>
                <div class="news-source">Source: <strong>{news.source}</strong></div>
              </div>
            ))}
          </div>
        </div>

        <!-- Fast Actuarial Facts Card -->
        <div class="sidebar-block card facts-block">
          <div class="block-header">
            <span class="block-icon">💡</span>
            <div>
              <h3>Actuarial & Rate Facts</h3>
              <span class="block-meta">Verified Consumer Benchmarks</span>
            </div>
          </div>
          <div class="facts-list">
            {insuranceFacts.map((fact) => (
              <div class="fact-item">
                <div class="fact-top">
                  <span class="fact-stat">{fact.number}</span>
                  <span class="fact-label">{fact.label}</span>
                </div>
                <p class="fact-text">{fact.fact}</p>
                <span class="fact-citation">Source: {fact.source}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pass Articles Data for Client-Side Shuffle -->
  <script is:inline define:vars={{ allArticles }}>
    const shuffleBtn = document.getElementById('shuffle-articles-btn');
    const container = document.getElementById('random-articles-container');

    function getRandomSubarray(arr, size) {
      const shuffled = [...arr].sort(() => 0.5 - Math.random());
      return shuffled.slice(0, size);
    }

    function renderArticles(articlesList) {
      if (!container) return;
      container.innerHTML = articlesList.map(art => `
        <article class="random-article-card card" data-slug="${art.url}">
          <div class="card-top-bar">
            <span class="tag-badge">${art.tagIcon} ${art.category}</span>
            <span class="read-time">${art.readTime}</span>
          </div>
          <h4 class="random-card-title">
            <a href="${art.url}">${art.title}</a>
          </h4>
          <p class="random-card-excerpt">${art.excerpt}</p>
          <div class="card-footer">
            <span class="reviewer-stamp">✓ ${art.reviewer}</span>
            <a href="${art.url}" class="intel-read-btn">Read Article &rarr;</a>
          </div>
        </article>
      `).join('');
    }

    if (shuffleBtn && container) {
      shuffleBtn.addEventListener('click', () => {
        shuffleBtn.classList.add('spinning');
        const randomPicks = getRandomSubarray(allArticles, 4);
        renderArticles(randomPicks);
        setTimeout(() => {
          shuffleBtn.classList.remove('spinning');
        }, 400);
      });
    }
  </script>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    background: linear-gradient(135deg, #0c1e33 0%, #153252 100%);
    color: #ffffff;
    padding: 4.5rem 0 3.5rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-container {
    max-width: 1140px;
    text-align: center;
  }

  .hero-badge {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    color: #ffffff;
    font-size: 3rem;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.15rem;
    }
  }

  .hero-lead {
    font-size: 1.2rem;
    color: #cbd5e1;
