---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Global News, Trends, Tech, Consumer Finance & Surprising Facts articles
const globalNewsArticles = [
  {
    id: 'ai-global-economy-workplace',
    category: 'Technology & Work',
    badge: 'Global Tech',
    title: 'How Generative AI Is Reshaping White-Collar Jobs and Corporate Budgets Worldwide',
    excerpt: 'From multinational finance institutions to small consulting firms, enterprise automation has shifted from experimental pilots to core operational infrastructure in 2026.',
    url: '/news/ai-global-economy-workplace/',
    author: 'Alexander Wright',
    date: 'October 5, 2026',
    readTime: '6 min read',
    icon: '🤖',
    featured: true
  },
  {
    id: 'renewable-energy-milestones',
    category: 'Energy & Climate',
    badge: 'Clean Tech',
    title: 'Global Solar and Battery Capacity Crosses Historical Grid Parity Benchmarks',
    excerpt: 'Surpassing initial 2030 forecasts four years ahead of schedule, utility-scale renewable generation and grid-scale storage costs drop to unprecedented record lows.',
    url: '/news/renewable-energy-milestones/',
    author: 'Dr. Clara Thorne',
    date: 'October 4, 2026',
    readTime: '7 min read',
    icon: '⚡',
    featured: true
  },
  {
    id: 'space-commercial-expansion',
    category: 'Science & Aerospace',
    badge: 'Frontier Tech',
    title: 'Commercial Satellite Megaconstellations and the Race for Low-Earth Orbit Dominance',
    excerpt: 'Private space logistics, direct-to-device satellite communications, and orbital debris regulatory treaties capture global attention this year.',
    url: '/news/space-commercial-expansion/',
    author: 'Liam Vance',
    date: 'October 3, 2026',
    readTime: '5 min read',
    icon: '🚀',
    featured: false
  },
  {
    id: 'global-supply-chains-automation',
    category: 'Trade & Logistics',
    badge: 'Global Commerce',
    title: 'Autonomous Freight Corridors: How Smart Ports Are Cutting International Transit Times',
    excerpt: 'Deep-sea ports across Rotterdam, Singapore, and Los Angeles deploy fully automated container cranes and predictive customs logistics to eliminate bottleneck delays.',
    url: '/news/global-supply-chains-automation/',
    author: 'Miriam O’Connor',
    date: 'October 2, 2026',
    readTime: '6 min read',
    icon: '🚢',
    featured: false
  },
  {
    id: 'longevity-science-breakthroughs',
    category: 'Health & Science',
    badge: 'Biomedicine',
    title: 'Cellular Reprogramming and Biomarker Testing: The New Frontier in Preventive Longevity',
    excerpt: 'Clinical trials investigating senolytic molecules and epigenetic clock tracking reveal dramatic potential for extending disease-free human healthspan.',
    url: '/news/longevity-science-breakthroughs/',
    author: 'Dr. Clara Thorne',
    date: 'October 1, 2026',
    readTime: '8 min read',
    icon: '🧬',
    featured: false
  },
  {
    id: 'remote-work-digital-nomad-economies',
    category: 'Lifestyle & Economics',
    badge: 'Global Living',
    title: 'The Second Wave of Digital Nomad Visas: How Cities Compete for Remote Knowledge Workers',
    excerpt: 'Over 65 countries have launched tailored residency programs, sparking tax reforms, specialized co-living hubs, and regional economic revitalization.',
    url: '/news/remote-work-digital-nomad-economies/',
    author: 'Elena Rostova',
    date: 'September 28, 2026',
    readTime: '5 min read',
    icon: '🌍',
    featured: false
  }
];

// Curated Global Fascinating Facts across Science, History, Economics & Nature
const globalFacts = [
  {
    category: 'Oceanography & Planet',
    metric: '99%',
    title: 'Unexplored Living Space',
    fact: 'Over 99% of the planet\'s habitable living space resides in the oceans, yet humans have mapped the surfaces of the Moon and Mars with greater resolution than Earth\'s own deep ocean floor.',
    source: 'National Oceanic and Atmospheric Administration (NOAA)'
  },
  {
    category: 'Global Economics',
    metric: '92%',
    title: 'Digital Money Circulation',
    fact: 'More than 92% of the world\'s entire currency supply exists solely in digital form on secure computer servers—physical bills and minted coins represent less than 8% of total global money.',
    source: 'Bank for International Settlements (BIS)'
  },
  {
    category: 'Neuroscience & Biology',
    metric: '20%',
    title: 'Brain Energy Consumption',
    fact: 'The adult human brain accounts for roughly 2% of total body mass, yet it burns more than 20% of your body\'s daily resting glucose and oxygen intake to power continuous synaptic signaling.',
    source: 'National Institutes of Health (NIH)'
  },
  {
    category: 'Aviation & Physics',
    metric: '100,000+',
    title: 'Flights Daily',
    fact: 'On any given standard weekday, over 100,000 commercial and cargo aircraft navigate global airspace simultaneously without a single mid-air radar blind spot.',
    source: 'International Civil Aviation Organization (ICAO)'
  },
  {
    category: 'Materials Science',
    metric: '200x',
    title: 'Graphene Tensile Strength',
    fact: 'A single atomic sheet of carbon graphene is over 200 times stronger than structural steel by weight while remaining virtually transparent and conducting electricity better than copper.',
    source: 'American Physical Society'
  },
  {
    category: 'Human Memory & Time',
    metric: '3 Seconds',
    title: 'The Psychological "Present"',
    fact: 'Psychophysiological studies demonstrate that the human perceptual sensation of "the present moment" lasts between 2.5 and 3 seconds before being processed into short-term memory.',
    source: 'Max Planck Institute for Human Cognitive and Brain Sciences'
  }
];
---

<BaseLayout
  title="Global News, Tech Wire & Fascinating Facts — QuoteShield Hub"
  description="Explore breaking global trends, science breakthroughs, world economic analysis, and astonishing verified facts curated by independent researchers."
>
  <!-- Hero Section -->
  <section class="news-hero">
    <div class="container hero-content">
      <div class="hero-badge">
        <span class="badge badge-accent">🌐 Global Wire & Knowledge Center</span>
      </div>
      <h1 class="hero-heading">Global News, Technological Shifts & Fascinating Facts</h1>
      <p class="hero-lead">
        Beyond insurance metrics, we track macroeconomic trends, scientific breakthroughs, technological transformations, and astonishing verified facts shaping our world.
      </p>

      <!-- Category Filter Pills -->
      <div class="news-topics-bar">
        <span class="topic-pill active">All Topics</span>
        <span class="topic-pill">🤖 AI & Tech</span>
        <span class="topic-pill">⚡ Energy & Climate</span>
        <span class="topic-pill">🧬 Longevity Science</span>
        <span class="topic-pill">🚀 Space & Physics</span>
        <span class="topic-pill">💡 World Facts</span>
      </div>
    </div>
  </section>

  <!-- Interactive Random Discovery Toolbar -->
  <section class="container filter-section">
    <div class="discovery-bar card">
      <div class="discovery-info">
        <h3>🎲 Random Article & Fact Explorer</h3>
        <p>Looking for something unexpected to read? Tap to shuffle and load random curated articles and surprising global facts.</p>
      </div>
      <button id="shuffle-global-btn" class="btn btn-primary btn-shuffle">
        <span class="spin-icon">🔄</span> Shuffle Random Story
      </button>
    </div>
  </section>

  <!-- Main Content Layout -->
  <section class="container section-padding">
    <div class="news-main-grid">
      <!-- Left Column: Articles Stream -->
      <div class="articles-column">
        <div class="section-title-row">
          <h2>Latest Global Dispatch & Analysis</h2>
          <span class="article-count">{globalNewsArticles.length} In-Depth Articles</span>
        </div>

        <div id="articles-container" class="articles-cards-grid">
          {globalNewsArticles.map((article) => (
            <article class="news-card card" data-id={article.id}>
              <div class="card-meta-top">
                <span class="category-tag">{article.icon} {article.category}</span>
                <span class="read-duration">{article.readTime}</span>
              </div>
              <h3 class="news-title">
                <a href={article.url}>{article.title}</a>
              </h3>
              <p class="news-excerpt">{article.excerpt}</p>
              <div class="card-author-footer">
                <div class="author-info">
                  <span class="author-name">By {article.author}</span>
                  <span class="publish-date">{article.date}</span>
                </div>
                <a href={article.url} class="read-story-link">Read Full Story &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Right Column: Fascinating Verified Facts Sidebar -->
      <aside class="facts-sidebar">
        <div class="facts-card card">
          <div class="facts-header">
            <span class="facts-icon">💡</span>
            <div>
              <h3>Astonishing Global Facts</h3>
              <p class="facts-subtitle">Scientifically & statistically verified trivia</p>
            </div>
          </div>

          <div class="facts-stack">
            {globalFacts.map((fact) => (
              <div class="fact-box">
                <div class="fact-top-row">
                  <span class="fact-metric">{fact.metric}</span>
                  <span class="fact-topic-tag">{fact.category}</span>
                </div>
                <h4 class="fact-title">{fact.title}</h4>
                <p class="fact-desc">{fact.fact}</p>
                <span class="fact-ref">Verified by: {fact.source}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Quick Subscribe / Stay Informed Box -->
        <div class="digest-card card">
          <h3>📬 The Morning Knowledge Digest</h3>
          <p>Curated briefing of the day's essential technological developments, macro data, and fascinating curiosities.</p>
          <div class="digest-perks">
            <span>✓ 100% Free & Independent</span>
            <span>✓ Zero algorithmic spam</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Client-side Interactive Shuffle Script -->
  <script is:inline define:vars={{ globalNewsArticles }}>
    const shuffleBtn = document.getElementById('shuffle-global-btn');
    const container = document.getElementById('articles-container');

    if (shuffleBtn && container) {
      shuffleBtn.addEventListener('click', () => {
        shuffleBtn.classList.add('spinning');
        const shuffled = [...globalNewsArticles].sort(() => 0.5 - Math.random());
        
        container.innerHTML = shuffled.map(art => `
          <article class="news-card card animate-fade" data-id="${art.id}">
            <div class="card-meta-top">
              <span class="category-tag">${art.icon} ${art.category}</span>
              <span class="read-duration">${art.readTime}</span>
            </div>
            <h3 class="news-title">
              <a href="${art.url}">${art.title}</a>
            </h3>
            <p class="news-excerpt">${art.excerpt}</p>
            <div class="card-author-footer">
              <div class="author-info">
                <span class="author-name">By ${art.author}</span>
                <span class="publish-date">${art.date}</span>
              </div>
              <a href="${art.url}" class="read-story-link">Read Full Story &rarr;</a>
            </div>
          </article>
        `).join('');

        setTimeout(() => {
          shuffleBtn.classList.remove('spinning');
        }, 350);
      });
    }
  </script>
</BaseLayout>

<style>
  /* News Hero */
  .news-hero {
    background: linear-gradient(135deg, #091e3a 0%, #173860 100%);
    color: #ffffff;
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-heading {
    font-size: 2.75rem;
    line-height: 1.2;
    margin: 1rem 0 1.25rem;
    color: #ffffff;
  }

  .hero-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin-bottom: 2rem;
  }

  .news-topics-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topic-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .topic-pill:hover,
  .topic-pill.active {
    background: #ffffff;
    color: #091e3a;
    border-color: #ffffff;
    font-weight: 600;
  }

  /* Discovery Bar */
  .filter-section {
    margin-top: -1.75rem;
    position: relative;
    z-index: 10;
  }

  .discovery-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background: #ffffff;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .discovery-info h3 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    color: var(--color-primary);
  }

  .discovery-info p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .btn-shuffle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .spin-icon {
    display: inline-block;
    transition: transform 0.4s ease;
  }

  .btn-shuffle.spinning .spin-icon {
    transform: rotate(360deg);
  }

  /* Main Grid */
  .news-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .news-main-grid {
      grid-template-columns: 1.75fr 1fr;
    }
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.75rem;
  }

  .section-title-row h2 {
    font-size: 1.6rem;
    margin: 0;
    color: var(--color-primary);
  }

  .article-count {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  /* Articles Cards */
  .articles-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .news-card {
    padding: 1.75rem;
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .news-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: #3b82f6;
  }

  .card-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .category-tag {
    background: #eff6ff;
    color: #1d4ed8;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .read-duration {
    font-size: 0.8rem;
    color: #64748b;
  }

  .news-title {
    font-size: 1.35rem;
    line-height: 1.35;
    margin: 0 0 0.75rem;
  }

  .news-title a {
    color: #0f172a;
    text-decoration: none;
  }

  .news-title a:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  .news-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 1.25rem;
  }

  .card-author-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .author-info {
    font-size: 0.825rem;
  }

  .author-name {
    font-weight: 600;
    color: #1e293b;
    margin-right: 0.75rem;
  }

  .publish-date {
    color: #94a3b8;
  }

  .read-story-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .read-story-link:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  /* Facts Sidebar */
  .facts-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .facts-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: 1.75rem;
  }

  .facts-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f1f5f9;
  }

  .facts-icon {
    font-size: 2rem;
  }

  .facts-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-primary);
  }

  .facts-subtitle {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: #64748b;
  }

  .facts-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fact-box {
    background: #f8fafc;
    border-left: 4px solid #f59e0b;
    padding: 1rem 1.15rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .fact-top-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }

  .fact-metric {
    font-size: 1.5rem;
    font-weight: 800;
    color: #b45309;
  }

  .fact-topic-tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.03em;
  }

  .fact-title {
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
    color: #0f172a;
  }

  .fact-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #475569;
    margin: 0 0 0.5rem;
  }

  .fact-ref {
    display: block;
    font-size: 0.725rem;
    color: #94a3b8;
    font-style: italic;
  }

  /* Digest Card */
  .digest-card {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .digest-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: #1e3a8a;
  }

  .digest-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #3b82f6;
    margin: 0 0 1rem;
  }

  .digest-perks {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #1d4ed8;
    font-weight: 600;
  }
</style>
