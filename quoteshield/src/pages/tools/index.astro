---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Insurance Calculators & Decision Tools — QuoteShield"
  description="Free interactive insurance comparison tools: Auto Insurance Savings Calculator, Life Insurance Coverage Estimator, and State Rate Benchmarks."
>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-trust">Interactive Research Tools</span>
      <h1>Consumer Insurance Calculators & Decision Tools</h1>
      <p class="subtitle">
        Free, private, zero-registration calculators engineered to help American policyholders identify overpayments and determine accurate coverage limits.
      </p>
    </div>
  </div>

  <div class="container page-content">
    <div class="tools-grid">
      <!-- Tool 1: Auto Savings Calculator -->
      <div class="tool-card card">
        <div class="tool-icon">🚗</div>
        <div class="tool-body">
          <span class="badge badge-trust">Most Popular</span>
          <h2>Auto Insurance Savings Estimator</h2>
          <p>
            Calculate how much you could save on your car insurance premium based on your state of residence, driving record, vehicle class, and available discount triggers.
          </p>
          <ul class="tool-features">
            <li>✓ State-specific rate filing multipliers</li>
            <li>✓ Telematics / usage-based insurance savings</li>
            <li>✓ Multi-policy bundling estimate</li>
          </ul>
          <a href="/tools/auto-savings-calculator/" class="btn btn-primary" style="margin-top: 1.25rem;">Launch Auto Estimator &rarr;</a>
        </div>
      </div>

      <!-- Tool 2: Life Insurance Calculator -->
      <div class="tool-card card">
        <div class="tool-icon">🛡️</div>
        <div class="tool-body">
          <span class="badge badge-primary">Financial Planning</span>
          <h2>Life Insurance Coverage Estimator</h2>
          <p>
            Determine exactly how much life insurance protection your family needs using the industry-standard DIME (Debt, Income, Mortgage, Education) methodology.
          </p>
          <ul class="tool-features">
            <li>✓ Income replacement multiplier</li>
            <li>✓ Mortgage payoff & debt settlement</li>
            <li>✓ Term length recommendation (10, 20, 30 years)</li>
          </ul>
          <a href="/tools/life-insurance-calculator/" class="btn btn-primary" style="margin-top: 1.25rem;">Launch Life Estimator &rarr;</a>
        </div>
      </div>

      <!-- Tool 3: State Average Matrix -->
      <div class="tool-card card">
        <div class="tool-icon">📊</div>
        <div class="tool-body">
          <span class="badge badge-primary">Data Hub</span>
          <h2>50-State Auto Insurance Rate Matrix</h2>
          <p>
            Explore average full coverage vs. minimum liability premiums across all 50 states, ranked from most affordable to highest cost with state regulatory minimums.
          </p>
          <ul class="tool-features">
            <li>✓ 2026 NAIC benchmark averages</li>
            <li>✓ No-fault vs. tort liability states</li>
            <li>✓ Uninsured motorist requirement rankings</li>
          </ul>
          <a href="/guides/state-car-insurance-averages/" class="btn btn-secondary" style="margin-top: 1.25rem;">View State Data Table &rarr;</a>
        </div>
      </div>

      <!-- Tool 4: Term vs Whole Life Matrix -->
      <div class="tool-card card">
        <div class="tool-icon">⚖️</div>
        <div class="tool-body">
          <span class="badge badge-primary">Cost Comparison</span>
          <h2>Term vs. Whole Life Cost Comparison</h2>
          <p>
            Compare cost differences across age brackets (20s, 30s, 40s, 50s, 60s) for $250k, $500k, and $1,000,000 policy limits, complete with cash-value analysis.
          </p>
          <ul class="tool-features">
            <li>✓ Male vs. female rate actuarial charts</li>
            <li>✓ Rate lock duration impacts</li>
            <li>✓ Surrender charge & fee breakdown</li>
          </ul>
          <a href="/guides/life-insurance/" class="btn btn-secondary" style="margin-top: 1.25rem;">View Life Comparison &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Privacy Guarantee -->
    <div class="callout callout-trust" style="margin-top: 3.5rem;">
      <div class="callout-title">🔒 100% Client-Side Privacy Guarantee</div>
      <p class="callout-text">
        All QuoteShield tools run directly within your browser. We never require your social security number, telephone number, or email address to generate an estimate. Your financial inputs are never stored, sold, or shared with third-party telemarketing networks.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #0c1e33 0%, #153252 100%);
    color: #ffffff;
    padding: 3.5rem 0 3rem;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 2.5rem;
    margin: 1rem 0 0.75rem;
  }

  .subtitle {
    color: #cbd5e1;
    font-size: 1.15rem;
    max-width: 800px;
    margin-bottom: 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
  }

  .tool-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .tool-body h2 {
    font-size: 1.45rem;
    margin: 0.75rem 0;
  }

  .tool-features {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
  }

  .tool-features li {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.4rem;
  }

  .callout-trust {
    border-left: 4px solid var(--color-accent);
    background: #f0fdf4;
  }
</style>
