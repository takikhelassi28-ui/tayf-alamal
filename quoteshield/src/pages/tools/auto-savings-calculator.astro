---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Auto Insurance Savings Calculator 2026 — Estimate Your Rate Reduction"
  description="Free interactive car insurance savings calculator. Enter your state, current premium, and vehicle profile to see how much you could save with top US carriers."
>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-trust">Interactive Rate Estimator</span>
      <h1>Auto Insurance Savings Calculator</h1>
      <p class="subtitle">
        Discover how much you are overpaying on car insurance. Benchmark your current premium against regional rate filings and unlock hidden policy discounts.
      </p>
    </div>
  </div>

  <div class="container page-content">
    <div class="calculator-wrapper">
      <!-- Calculator Inputs Form -->
      <div class="calc-panel card">
        <h3 class="panel-title">1. Your Driver & Policy Profile</h3>

        <div class="form-group">
          <label for="state-select">Your State of Residence</label>
          <select id="state-select" class="form-input">
            <option value="1.0">California (Moderate-High)</option>
            <option value="1.25">Florida (High Risk / Storms)</option>
            <option value="1.15">Texas (High Density)</option>
            <option value="1.20">New York (Urban Density)</option>
            <option value="1.30">Michigan (High PIP No-Fault)</option>
            <option value="0.80">Ohio (Very Competitive)</option>
            <option value="0.85">Pennsylvania (Moderate)</option>
            <option value="0.88">Illinois (Average)</option>
            <option value="0.95">Georgia (Moderate-High)</option>
            <option value="0.75">Idaho / Maine / Iowa (Low Risk)</option>
            <option value="1.0" selected>Other US State (National Average)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="age-select">Driver Age Bracket</label>
          <select id="age-select" class="form-input">
            <option value="1.35">Young Driver (18 – 24 years)</option>
            <option value="1.05">Early Career (25 – 34 years)</option>
            <option value="1.0" selected>Prime Adult (35 – 54 years)</option>
            <option value="0.95">Mature Adult (55 – 64 years)</option>
            <option value="1.10">Senior Driver (65+ years)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="record-select">Driving Record (Past 36 Months)</label>
          <select id="record-select" class="form-input">
            <option value="1.0" selected>Clean Record (No tickets or accidents)</option>
            <option value="1.22">1 Minor Speeding Violation</option>
            <option value="1.45">1 At-Fault Accident</option>
            <option value="1.80">Multiple Infractions / SR-22 Required</option>
          </select>
        </div>

        <div class="form-group">
          <label for="current-premium">Current Annual Premium: <strong id="premium-val-display">$2,100</strong> / year</label>
          <input type="range" id="current-premium" min="600" max="4500" step="50" value="2100" class="range-slider" />
          <div class="range-bounds">
            <span>$600</span>
            <span>$2,500</span>
            <span>$4,500</span>
          </div>
        </div>

        <h3 class="panel-title" style="margin-top: 1.75rem;">2. Available Discount Levers</h3>
        <p class="panel-subtext">Select discounts you are eligible for or willing to adopt:</p>

        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" id disc-bundle class="discount-check" data-discount="0.14" checked />
            <span><strong>Multi-Policy Bundle</strong> (Combine with Home/Renters) ~14% off</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id disc-telematics class="discount-check" data-discount="0.12" checked />
            <span><strong>Telematics / Safe Driver App</strong> (DriveSafe&Save / Snapshot) ~12% off</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id disc-deductible class="discount-check" data-discount="0.10" />
            <span><strong>Raise Collision Deductible</strong> ($500 &rarr; $1,000) ~10% off</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id disc-payfull class="discount-check" data-discount="0.05" checked />
            <span><strong>Pay in Full / Paperless Auto-Pay</strong> ~5% off</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id disc-defensive class="discount-check" data-discount="0.06" />
            <span><strong>Defensive Driver Course / Clean 5-Yr History</strong> ~6% off</span>
          </label>
        </div>
      </div>

      <!-- Results Display Panel -->
      <div class="results-panel card">
        <span class="badge badge-trust">Estimated Policy Optimization</span>
        <h2>Your Potential Savings Breakdown</h2>

        <div class="result-highlight-box">
          <span class="result-metric-label">Estimated Annual Savings</span>
          <div class="result-number" id="savings-annual">$567</div>
          <span class="result-monthly" id="savings-monthly">That's approx. $47 / month back in your pocket</span>
        </div>

        <div class="rate-comparison-metrics">
          <div class="metric-row">
            <span>Your Current Premium:</span>
            <strong id="display-current">$2,100 / yr</strong>
          </div>
          <div class="metric-row">
            <span>Optimized Target Premium:</span>
            <strong id="display-optimized" style="color: var(--color-accent); font-size: 1.15rem;">$1,533 / yr</strong>
          </div>
          <div class="metric-row">
            <span>Overall Reduction:</span>
            <strong id="display-percent" class="highlight-green">27.0% Savings</strong>
          </div>
        </div>

        <div class="recommendation-box">
          <h4>💡 Recommended Action Plan</h4>
          <ul class="action-list">
            <li><strong>Shop Mutuals & Regionals:</strong> If you have a clean record, policyholder-owned mutuals (like Amica, Erie, or USAA if military-affiliated) frequently undercut national stock giants by 15–20%.</li>
            <li><strong>Enroll in Telematics:</strong> Insurers now offer 10% instant discounts for enrolling in phone-based driving sensors, with good drivers locking in up to 25% renewals.</li>
            <li><strong>Re-shop Every 12 Months:</strong> Carriers use "price optimization" algorithms that gradually raise rates on loyal policyholders who never compare.</li>
          </ul>
        </div>

        <div class="tool-guide-link">
          <a href="/guides/cheap-car-insurance-guide/" class="btn btn-primary" style="width: 100%;">
            Read Full Cheap Car Insurance Guide &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Deep Dive -->
    <section class="section article-content" style="margin-top: 3.5rem;">
      <h2>How Car Insurance Rating Formulas Actually Work</h2>
      <p>
        Insurance companies do not guess your rate—they use actuarial formulas governed by state regulatory filings. Actuaries determine your base rate using your ZIP code territory, then apply proprietary multipliers known as <em>rating factors</em>.
      </p>

      <h3>1. Credit-Based Insurance Scores (In 46 States)</h3>
      <p>
        Except in California, Massachusetts, Hawaii, and Michigan (where credit consideration is prohibited or restricted by law), insurance companies evaluate your credit-based insurance score (CBIS). Studies published by the Federal Trade Commission (FTC) confirmed that drivers with poor credit scores file up to 40% more dollars in claims than drivers with excellent credit scores, resulting in premium disparities as high as 80%.
      </p>

      <h3>2. The Territory Multiplier</h3>
      <p>
        Two drivers with identical 2024 Honda Accords and spotless records can experience a $1,200 annual price variance simply by residing in different ZIP codes five miles apart. Urban areas experience higher theft, vandalism, litigation frequency, and uninsured driver ratios, requiring carriers to adjust regional baseline rates.
      </p>

      <h3>3. Deductible Sweet Spots</h3>
      <p>
        A $500 collision and comprehensive deductible feels safe, but carrying a $1,000 deductible reduces physical damage premium by 10% to 15%. If you maintain an emergency fund capable of covering the extra $500 in an accident, opting for the higher deductible saves money every single renewal cycle.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  function calculateSavings() {
    const stateMult = parseFloat((document.getElementById('state-select') as HTMLSelectElement).value);
    const ageMult = parseFloat((document.getElementById('age-select') as HTMLSelectElement).value);
    const recordMult = parseFloat((document.getElementById('record-select') as HTMLSelectElement).value);
    const currentPrem = parseFloat((document.getElementById('current-premium') as HTMLInputElement).value);

    // Sum discounts
    const discountCheckboxes = document.querySelectorAll('.discount-check:checked');
    let totalDiscountPercent = 0;
    discountCheckboxes.forEach((box) => {
      totalDiscountPercent += parseFloat((box as HTMLInputElement).getAttribute('data-discount') || '0');
    });

    // Cap total practical discount at 42%
    totalDiscountPercent = Math.min(totalDiscountPercent, 0.42);

    const annualSavings = Math.round(currentPrem * totalDiscountPercent);
    const optimizedPrem = Math.round(currentPrem - annualSavings);
    const monthlySavings = Math.round(annualSavings / 12);
    const percentSavings = ((annualSavings / currentPrem) * 100).toFixed(1);

    // Update UI
    const savingsAnnualEl = document.getElementById('savings-annual');
    const savingsMonthlyEl = document.getElementById('savings-monthly');
    const displayCurrentEl = document.getElementById('display-current');
    const displayOptimizedEl = document.getElementById('display-optimized');
    const displayPercentEl = document.getElementById('display-percent');
    const premiumValDisplay = document.getElementById('premium-val-display');

    if (savingsAnnualEl) savingsAnnualEl.textContent = `$${annualSavings.toLocaleString()}`;
    if (savingsMonthlyEl) savingsMonthlyEl.textContent = `That's approx. $${monthlySavings} / month back in your pocket`;
    if (displayCurrentEl) displayCurrentEl.textContent = `$${currentPrem.toLocaleString()} / yr`;
    if (displayOptimizedEl) displayOptimizedEl.textContent = `$${optimizedPrem.toLocaleString()} / yr`;
    if (displayPercentEl) displayPercentEl.textContent = `${percentSavings}% Savings`;
    if (premiumValDisplay) premiumValDisplay.textContent = `$${currentPrem.toLocaleString()}`;
  }

  // Event Listeners
  document.getElementById('current-premium')?.addEventListener('input', calculateSavings);
  document.getElementById('state-select')?.addEventListener('change', calculateSavings);
  document.getElementById('age-select')?.addEventListener('change', calculateSavings);
  document.getElementById('record-select')?.addEventListener('change', calculateSavings);

  document.querySelectorAll('.discount-check').forEach(box => {
    box.addEventListener('change', calculateSavings);
  });

  // Initial calculation
  calculateSavings();
</script>

<style>
  .page-header {
    background: linear-gradient(135deg, #0c1e33 0%, #153252 100%);
    color: #ffffff;
    padding: 3.5rem 0 3rem;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 2.5rem;
    margin: 1rem 0 0.75rem;
  }

  .subtitle {
    color: #cbd5e1;
    font-size: 1.15rem;
    max-width: 800px;
    margin-bottom: 0;
  }

  .calculator-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .calculator-wrapper {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .calc-panel {
    padding: 2.25rem;
  }

  .panel-title {
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .panel-subtext {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.45rem;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    background: #ffffff;
  }

  .range-slider {
    width: 100%;
    margin: 0.75rem 0 0.25rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .range-bounds {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
    width: 18px;
    height: 18px;
  }

  /* Results Panel */
  .results-panel {
    padding: 2.25rem;
    background: #ffffff;
    border: 2px solid var(--color-accent-border);
    position: sticky;
    top: 90px;
  }

  .results-panel h2 {
    font-size: 1.45rem;
    margin: 0.5rem 0 1.25rem;
  }

  .result-highlight-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .result-metric-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #166534;
    letter-spacing: 0.05em;
  }

  .result-number {
    font-size: 3rem;
    font-weight: 800;
    color: #15803d;
    line-height: 1.1;
    margin: 0.35rem 0;
  }

  .result-monthly {
    font-size: 0.875rem;
    color: #166534;
    font-weight: 500;
  }

  .rate-comparison-metrics {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .recommendation-box {
    background: #f8fafc;
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .recommendation-box h4 {
    font-size: 0.95rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .action-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .action-list li {
    margin-bottom: 0.65rem;
    line-height: 1.45;
  }
</style>
