---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Life Insurance Coverage Calculator 2026 — DIME Method Estimator"
  description="Calculate how much term life insurance coverage you need using the certified DIME formula: Debt, Income Replacement, Mortgage, and College Education."
>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-trust">Certified Financial Method</span>
      <h1>Life Insurance Needs Calculator (DIME Method)</h1>
      <p class="subtitle">
        Avoid the twin traps of costly over-insurance and catastrophic under-insurance. Calculate your family's exact financial security requirement with our independent estimator.
      </p>
    </div>
  </div>

  <div class="container page-content">
    <div class="calculator-wrapper">
      <!-- Calculator Inputs Form -->
      <div class="calc-panel card">
        <h3 class="panel-title">1. Your Financial Liabilities (DIME Framework)</h3>

        <div class="form-group">
          <label for="debt-input"><strong>D — Debts:</strong> Non-Mortgage Balances (Auto, Credit Cards, Loans)</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">$</span>
            <input type="number" id="debt-input" value="25000" min="0" step="5000" class="form-input with-prefix" />
          </div>
        </div>

        <div class="form-group">
          <label for="income-input"><strong>I — Income:</strong> Your Annual Pre-Tax Earnings</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">$</span>
            <input type="number" id="income-input" value="85000" min="0" step="5000" class="form-input with-prefix" />
          </div>
        </div>

        <div class="form-group">
          <label for="years-replace">Income Replacement Duration</label>
          <select id="years-replace" class="form-input">
            <option value="5">5 Years (Children nearly independent)</option>
            <option value="10" selected>10 Years (Industry Standard Benchmark)</option>
            <option value="15">15 Years (Young family / single breadwinner)</option>
            <option value="20">20 Years (Newborn infant protection)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="mortgage-input"><strong>M — Mortgage:</strong> Remaining Home Loan Balance</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">$</span>
            <input type="number" id="mortgage-input" value="320000" min="0" step="10000" class="form-input with-prefix" />
          </div>
        </div>

        <div class="form-group">
          <label for="education-input"><strong>E — Education:</strong> College Tuition Funding for Children</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">$</span>
            <input type="number" id="education-input" value="100000" min="0" step="10000" class="form-input with-prefix" />
          </div>
          <span class="field-hint">Avg. 4-year in-state public university is ~$100k per child.</span>
        </div>

        <h3 class="panel-title" style="margin-top: 1.75rem;">2. Deduct Existing Assets</h3>

        <div class="form-group">
          <label for="assets-input">Existing Liquid Assets (Savings, 401k, Current Life Policies)</label>
          <div class="input-prefix-wrap">
            <span class="input-prefix">$</span>
            <input type="number" id="assets-input" value="50000" min="0" step="5000" class="form-input with-prefix" />
          </div>
        </div>
      </div>

      <!-- Results Display Panel -->
      <div class="results-panel card">
        <span class="badge badge-trust">Recommended Policy Sizing</span>
        <h2>Your Total Life Insurance Need</h2>

        <div class="result-highlight-box">
          <span class="result-metric-label">Recommended Death Benefit</span>
          <div class="result-number" id="total-coverage">$1,245,000</div>
          <span class="result-term" id="recommended-term">Recommended: 20-Year Level Term Life</span>
        </div>

        <div class="rate-comparison-metrics">
          <div class="metric-row">
            <span>Debt Settlement:</span>
            <strong id="display-debt">$25,000</strong>
          </div>
          <div class="metric-row">
            <span>Income Replacement:</span>
            <strong id="display-income">$850,000</strong>
          </div>
          <div class="metric-row">
            <span>Mortgage Payoff:</span>
            <strong id="display-mortgage">$320,000</strong>
          </div>
          <div class="metric-row">
            <span>College Fund:</span>
            <strong id="display-education">$100,000</strong>
          </div>
          <div class="metric-row">
            <span>Less Existing Assets:</span>
            <strong id="display-assets" style="color: #059669;">-$50,000</strong>
          </div>
        </div>

        <div class="cost-estimate-card">
          <h4>Estimated Monthly Premium:</h4>
          <div class="cost-row">
            <span>Healthy 30-Year Old (Term):</span>
            <strong class="highlight-green">$38 – $48 / mo</strong>
          </div>
          <div class="cost-row">
            <span>Healthy 40-Year Old (Term):</span>
            <strong class="highlight-green">$58 – $76 / mo</strong>
          </div>
          <div class="cost-row">
            <span>Whole Life Alternative:</span>
            <span style="color: #94a3b8; text-decoration: line-through;">$420 – $650 / mo</span>
          </div>
        </div>

        <div class="tool-guide-link">
          <a href="/guides/life-insurance/" class="btn btn-primary" style="width: 100%;">
            Compare Term vs Whole Life Rates &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Content -->
    <section class="section article-content" style="margin-top: 3.5rem;">
      <h2>Why Financial Planners Overwhelmingly Recommend the DIME Method</h2>
      <p>
        The life insurance industry frequently uses arbitrary rules of thumb, like "buy 10 times your annual salary." While convenient, this heuristic ignores crucial personal financial realities. A parent with a paid-off mortgage and grown children needs vastly less coverage than an identical earner with three toddlers and a $500,000 mortgage balance.
      </p>

      <h3>1. Term Life vs. Cash Value Whole Life: The Cost Reality</h3>
      <p>
        For 95% of American working households, <strong>level term life insurance</strong> is the superior financial instrument. Whole life policies combine insurance protection with a built-in investment component, charging administrative fees that are 6 to 10 times more expensive for the exact same death benefit. By purchasing term life and investing the difference in diversified index funds, families build greater wealth with complete liquidity.
      </p>

      <h3>2. Laddering Term Policies to Save Thousands</h3>
      <p>
        Rather than buying a single 30-year $1,000,000 policy, consider "laddering":
      </p>
      <ul>
        <li>A $500,000 20-year term to cover the mortgage and college years;</li>
        <li>A $500,000 10-year term to cover peak income replacement while children are young.</li>
      </ul>
      <p>
        When the 10-year policy expires, your premiums drop in half just as your debts decrease and retirement assets compound.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  function calculateLifeNeeds() {
    const debts = parseFloat((document.getElementById('debt-input') as HTMLInputElement).value) || 0;
    const income = parseFloat((document.getElementById('income-input') as HTMLInputElement).value) || 0;
    const years = parseFloat((document.getElementById('years-replace') as HTMLSelectElement).value) || 10;
    const mortgage = parseFloat((document.getElementById('mortgage-input') as HTMLInputElement).value) || 0;
    const education = parseFloat((document.getElementById('education-input') as HTMLInputElement).value) || 0;
    const assets = parseFloat((document.getElementById('assets-input') as HTMLInputElement).value) || 0;

    const incomeTotal = income * years;
    const grossNeed = debts + incomeTotal + mortgage + education;
    const netCoverage = Math.max(0, grossNeed - assets);

    // Round up to nearest $25k
    const roundedCoverage = Math.ceil(netCoverage / 25000) * 25000;

    // Update UI elements
    const totalCoverageEl = document.getElementById('total-coverage');
    const recommendedTermEl = document.getElementById('recommended-term');
    const displayDebtEl = document.getElementById('display-debt');
    const displayIncomeEl = document.getElementById('display-income');
    const displayMortgageEl = document.getElementById('display-mortgage');
    const displayEducationEl = document.getElementById('display-education');
    const displayAssetsEl = document.getElementById('display-assets');

    if (totalCoverageEl) totalCoverageEl.textContent = `$${roundedCoverage.toLocaleString()}`;
    if (recommendedTermEl) recommendedTermEl.textContent = `Recommended: ${years >= 15 ? '20 or 30-Year' : '10 or 15-Year'} Level Term Life`;
    if (displayDebtEl) displayDebtEl.textContent = `$${debts.toLocaleString()}`;
    if (displayIncomeEl) displayIncomeEl.textContent = `$${incomeTotal.toLocaleString()}`;
    if (displayMortgageEl) displayMortgageEl.textContent = `$${mortgage.toLocaleString()}`;
    if (displayEducationEl) displayEducationEl.textContent = `$${education.toLocaleString()}`;
    if (displayAssetsEl) displayAssetsEl.textContent = `-$${assets.toLocaleString()}`;
  }

  // Bind inputs
  ['debt-input', 'income-input', 'mortgage-input', 'education-input', 'assets-input'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateLifeNeeds);
  });
  document.getElementById('years-replace')?.addEventListener('change', calculateLifeNeeds);

  // Initialize
  calculateLifeNeeds();
</script>

<style>
  .page-header {
    background: linear-gradient(135deg, #0c1e33 0%, #153252 100%);
    color: #ffffff;
    padding: 3.5rem 0 3rem;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 2.5rem;
    margin: 1rem 0 0.75rem;
  }

  .subtitle {
    color: #cbd5e1;
    font-size: 1.15rem;
    max-width: 800px;
    margin-bottom: 0;
  }

  .calculator-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .calculator-wrapper {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .calc-panel {
    padding: 2.25rem;
  }

  .panel-title {
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .form-group {
    margin-bottom: 1.35rem;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.45rem;
  }

  .input-prefix-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-prefix {
    position: absolute;
    left: 1rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    background: #ffffff;
  }

  .form-input.with-prefix {
    padding-left: 2rem;
  }

  .field-hint {
    display: block;
    font-size: 0.775rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  /* Results Panel */
  .results-panel {
    padding: 2.25rem;
    background: #ffffff;
    border: 2px solid var(--color-accent-border);
    position: sticky;
    top: 90px;
  }

  .results-panel h2 {
    font-size: 1.45rem;
    margin: 0.5rem 0 1.25rem;
  }

  .result-highlight-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .result-metric-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #166534;
    letter-spacing: 0.05em;
  }

  .result-number {
    font-size: 2.75rem;
    font-weight: 800;
    color: #15803d;
    line-height: 1.1;
    margin: 0.35rem 0;
  }

  .result-term {
    font-size: 0.875rem;
    color: #166534;
    font-weight: 600;
  }

  .rate-comparison-metrics {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    margin-bottom: 1.5rem;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .cost-estimate-card {
    background: #f8fafc;
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cost-estimate-card h4 {
    font-size: 0.95rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .cost-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    padding: 0.3rem 0;
  }
</style>
