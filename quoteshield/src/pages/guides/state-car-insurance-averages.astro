<script>
  // Filter table by state search
  const searchInput = document.getElementById('state-search-input') as HTMLInputElement;
  const table = document.getElementById('states-table');
  const rows = table?.querySelectorAll('tbody tr');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    rows?.forEach((row) => {
      const stateName = (row as HTMLElement).innerText.toLowerCase();
      if (stateName.includes(query)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  });
</script>

